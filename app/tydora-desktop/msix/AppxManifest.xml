<?xml version="1.0" encoding="utf-8"?>
<!--
  AppxManifest 模板 —— 用于打包 MSIX 提交到微软商店。

  占位符由 scripts/build-msix.ps1 在打包时替换：
    {{PACKAGE_IDENTITY_NAME}}  商店分配的包标识名（Partner Center > Product identity > Package/Identity/Name）
    {{PUBLISHER}}              商店分配的发布者（Partner Center > Product identity > Package/Identity/Publisher，形如 CN=...）
    {{VERSION}}                4 段版本号 X.Y.Z.W（由 VERSION 文件生成）

  注意：首次提交必须手动上传到 Partner Center，后续版本才能通过 GitHub Actions 自动发布。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="{{PACKAGE_IDENTITY_NAME}}"
            Publisher="{{PUBLISHER}}"
            Version="{{VERSION}}"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Tydora</DisplayName>
    <PublisherDisplayName>左瑞宁</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>一个现代的桌面 Markdown 编辑器，为思考与知识管理而生。基于 Tauri v2 + React 19 构建，轻量、快速、美观。</Description>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Applications>
    <Application Id="Tydora"
                 Executable="tydora.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Tydora"
        Description="一个现代的桌面 Markdown 编辑器，为思考与知识管理而生。基于 Tauri v2 + React 19 构建，轻量、快速、美观。"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="md">
            <uap:DisplayName>Markdown Document</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
              <uap:FileType>.mdx</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
