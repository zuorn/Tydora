# Copy to .env for local signed builds (never commit .env).
TAURI_SIGNING_PRIVATE_KEY=
# Optional path fallback (run-tauri.mjs can load it into the variable above)
# TAURI_SIGNING_PRIVATE_KEY_PATH=C:\Users\<YOU>\.tauri\tydora.key
# Required when the key is encrypted. Empty = no password (leave the = with nothing after it):
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
