{
  "name": "tydora",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/run-tauri.mjs",
    "build:msix": "powershell -ExecutionPolicy Bypass -File scripts/build-msix.ps1",
    "sync-version": "node scripts/sync-version.mjs",
    "docs:build": "node scripts/build-docs.mjs",
    "deploy:edgeone": "node scripts/deploy-edgeone.mjs",
    "docs:serve": "node website/site/__preview_server.cjs",
    "docs:clean": "rimraf website/site",
    "copy-landing": "node scripts/copy-landing.mjs",
    "postdocs:build": "node scripts/copy-landing.mjs && node scripts/inject-analytics.mjs",
    "postinstall": "patch-package",
    "commit": "cz",
    "changelog": "git-cliff -o CHANGELOG.md",
    "lint:commit": "commitlint --from HEAD~1"
  },
